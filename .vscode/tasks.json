{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev: server (watch)",
      "type": "shell",
      "command": "VITE_DEV_SERVER=http://localhost:5173 npm run dev:server",
      "problemMatcher": [],
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "detail": "tsx watch src/server.ts on :8080, loading the app from Vite (runs in the dev container when attached)"
    },
    {
      "label": "dev: app (vite)",
      "type": "shell",
      "command": "npm run dev:web",
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^__never__$" },
        "background": {
          "activeBegins": true,
          "beginsPattern": "VITE",
          "endsPattern": "ready in"
        }
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "detail": "Vite dev server on :5173 for the app's modules and hot reload; open the app on :8080"
    },
    {
      "label": "dev: all",
      "type": "shell",
      "command": "npm run dev",
      "problemMatcher": [],
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "detail": "npm run dev: Vite and the server together; open http://localhost:8080"
    },
    {
      "label": "test: all",
      "type": "shell",
      "command": "npm test",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": [],
      "detail": "node --test over src/**/*.test.ts via tsx"
    },
    {
      "label": "test: current file",
      "type": "shell",
      "command": "node --test --import tsx/esm \"${relativeFile}\"",
      "group": "test",
      "problemMatcher": [],
      "detail": "Run only the test file open in the editor"
    },
    {
      "label": "typecheck",
      "type": "shell",
      "command": "npm run typecheck",
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "problemMatcher": [
        "$tsc"
      ],
      "detail": "Type-check the server and the app (stands in for lint/format)"
    },
    {
      "label": "migrate",
      "type": "shell",
      "command": "npm run migrate",
      "problemMatcher": [],
      "detail": "Apply SQL migrations against DATABASE_PATH"
    },
    {
      "label": "build",
      "type": "shell",
      "command": "npm run build",
      "group": "build",
      "problemMatcher": [
        "$tsc"
      ],
      "detail": "tsc + copy .eta/.sql assets into dist/, then vite build into dist/web"
    },
    {
      "label": "build image (deploy.sh)",
      "type": "shell",
      "command": "./deploy.sh",
      "problemMatcher": [],
      "detail": "Build + push the container image. Runs on the HOST (needs docker/buildx), not the dev container."
    },
    {
      "label": "shell",
      "type": "shell",
      "command": "exec $SHELL",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "detail": "Open an interactive shell in the task environment"
    }
  ]
}
