<!doctype html>
<html lang="<%= it.locale ?? 'en' %>">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1d5286" />
    <title><%= it.title ?? "plaid-importer" %></title>
    <script>
      // Pick the theme before first paint so dark mode never flashes white.
      try {
        var t = localStorage.getItem("pi-theme");
        document.documentElement.dataset.theme = t === "light" || t === "dark" ? t : matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
      } catch (e) {}
    </script>
    <link rel="preload" href="/static/fonts/playfair-display-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/static/fonts/dm-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/static/style.css" />
  </head>
  <body>
    <%/* Sign-in pages only; signed-in pages are the app (web/). Icons are Feather (MIT), inline. */%>
    <div class="shell">
      <header class="site-head">
        <div class="site-title">
          <h1><%= it.t("shell.appName") %></h1>
          <span class="site-sub"><%= it.t("shell.appSub") %></span>
          <!-- Version only: locale-neutral, so no catalog entry. -->
          <span class="app-version"><%= it.version %></span>
        </div>
        <div class="site-tools">
          <button type="button" class="pill-button" id="theme-toggle" aria-pressed="false">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
            <span data-dark="<%= it.t('theme.dark') %>" data-light="<%= it.t('theme.light') %>"><%= it.t("theme.dark") %></span>
          </button>
          <label class="lang-select">
            <span class="visually-hidden"><%= it.t("lang.label") %></span>
            <select id="lang-select">
              <% ["en", "es"].forEach(function(l) { %>
                <option value="<%= l %>" <%= it.locale === l ? "selected" : "" %>><%= it.t("lang." + l) %></option>
              <% }) %>
            </select>
          </label>
        </div>
      </header>
      <main>
        <%~ it.body %>
      </main>
    </div>
    <script>
      (function () {
        var root = document.documentElement;
        var btn = document.getElementById("theme-toggle");
        var label = btn.querySelector("span");
        function paint() {
          var dark = root.dataset.theme === "dark";
          btn.setAttribute("aria-pressed", String(dark));
          label.textContent = dark ? label.dataset.light : label.dataset.dark;
        }
        paint();
        btn.addEventListener("click", function () {
          root.dataset.theme = root.dataset.theme === "dark" ? "light" : "dark";
          try { localStorage.setItem("pi-theme", root.dataset.theme); } catch (e) {}
          paint();
        });
        document.getElementById("lang-select").addEventListener("change", function (e) {
          document.cookie = "lang=" + e.target.value + "; path=/; max-age=31536000; samesite=lax";
          location.reload();
        });
      })();
    </script>
  </body>
</html>
