<section class="panel auth">
  <p class="eyebrow"><%= it.t("login.eyebrow") %></p>
  <h2><%= it.t("login.title") %></h2>
  <% if (it.errorKey) { %>
    <div class="notice error" role="alert"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg><div class="notice-body"><%= it.t(it.errorKey) %></div></div>
  <% } %>
  <form method="post" action="/login">
    <label for="username"><%= it.t("login.username") %>
      <input id="username" name="username" type="text" autocomplete="username" autofocus required />
    </label>
    <label for="password"><%= it.t("login.password") %>
      <input id="password" name="password" type="password" autocomplete="current-password" required />
    </label>
    <input type="hidden" name="next" value="<%= it.next %>" />
    <button type="submit" class="primary"><%= it.t("login.submit") %></button>
  </form>
  <p class="foot muted"><a href="/register"><%= it.t("login.needAccount") %></a></p>
</section>
