<section class="panel auth">
  <p class="eyebrow"><%= it.t("register.eyebrow") %></p>
  <h2><%= it.t("register.title") %></h2>
  <% if (it.errorKey) { %>
    <div class="notice error" role="alert"><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i><div class="notice-body"><%= it.t(it.errorKey) %></div></div>
  <% } %>
  <% if (!it.usersExist) { %>
    <div class="notice"><i class="fa-solid fa-circle-info" aria-hidden="true"></i><div class="notice-body"><%= it.t("register.firstAdmin") %></div></div>
  <% } %>
  <form method="post" action="/register">
    <label for="username"><%= it.t("login.username") %>
      <input id="username" name="username" type="text" autocomplete="username" autofocus required />
    </label>
    <label for="password"><%= it.t("login.password") %>
      <input id="password" name="password" type="password" autocomplete="new-password" required />
    </label>
    <% if (it.usersExist) { %>
      <label for="registration_secret"><%= it.t("register.secret") %>
        <input id="registration_secret" name="registration_secret" type="password" autocomplete="off" required />
      </label>
    <% } %>
    <button type="submit" class="primary"><i class="fa-solid fa-user-plus" aria-hidden="true"></i><%= it.t("register.submit") %></button>
  </form>
  <p class="foot muted"><a href="/login"><%= it.t("register.haveAccount") %></a></p>
</section>
