<%/* One column per day. Columns are focusable with a date + value tooltip, and
     a visually hidden table carries the same numbers for assistive tech.
     it: points [{ date, imported }], fmt, t, caption */%>
<% var pts = it.points; %>
<% var max = Math.max(1, ...pts.map(function(p) { return p.imported; })); %>
<% if (pts.every(function(p) { return p.imported === 0; })) { %>
  <p class="muted small"><%= it.t("insights.chart.empty") %></p>
<% } else { %>
  <figure class="column-chart grow">
    <div class="columns">
      <% pts.forEach(function(p) { %>
        <% var label = it.fmt.weekday(p.date) + " " + it.fmt.day(p.date) + ": " + it.t("insights.chart.imported", { count: it.fmt.num(p.imported) }); %>
        <div class="column" tabindex="0" role="img" aria-label="<%= label %>">
          <span class="column-fill<%= p.imported === 0 ? ' zero' : '' %>" style="height: <%= p.imported === 0 ? 1 : Math.max(2, p.imported / max * 100).toFixed(1) + '%' %><%= p.imported === 0 ? 'px' : '' %>"></span>
          <span class="tooltip" aria-hidden="true"><b><%= it.fmt.weekday(p.date) %> <%= it.fmt.day(p.date) %></b><span><%= it.t("insights.chart.imported", { count: it.fmt.num(p.imported) }) %></span></span>
        </div>
      <% }) %>
    </div>
    <div class="chart-axis" aria-hidden="true">
      <span><%= it.fmt.day(pts[0].date) %></span>
      <span><%= it.fmt.day(pts[Math.floor(pts.length / 2)].date) %></span>
      <span><%= it.fmt.day(pts[pts.length - 1].date) %></span>
    </div>
    <table class="visually-hidden">
      <caption><%= it.caption %></caption>
      <thead><tr><th scope="col"><%= it.t("insights.chart.date") %></th><th scope="col"><%= it.t("insights.chart.importedCol") %></th></tr></thead>
      <tbody>
        <% pts.forEach(function(p) { %><tr><td><%= it.fmt.day(p.date) %></td><td><%= it.fmt.num(p.imported) %></td></tr><% }) %>
      </tbody>
    </table>
  </figure>
<% } %>
