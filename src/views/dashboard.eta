<% var f = it.fmt; %>
<header class="page-intro">
  <div class="page-intro-text">
    <p class="eyebrow"><%= it.t("dashboard.eyebrow") %></p>
    <h2><%= it.t("dashboard.title") %></h2>
    <p class="lede"><%= it.t("dashboard.lede") %></p>
  </div>
</header>

<section class="hero-card">
  <div class="hero-main">
    <p class="eyebrow"><%= it.t("dashboard.hero.eyebrow") %></p>
    <p class="hero-number" data-count-to="<%= it.importedTotals.d30 %>"><%= f.num(it.importedTotals.d30) %></p>
    <span class="hero-caption">
      <% if (it.connectionCount === 0) { %><%= it.t("dashboard.hero.noConnections") %><% } else { %><%= it.t("dashboard.hero.caption") %><% } %>
    </span>
    <div class="hero-pills">
      <b><%= it.t("dashboard.hero.window", { count: f.num(it.importedTotals.d7), days: 7 }) %></b>
      <b><%= it.t("dashboard.hero.window", { count: f.num(it.importedTotals.d60), days: 60 }) %></b>
      <b><%= it.t("dashboard.hero.window", { count: f.num(it.importedTotals.d90), days: 90 }) %></b>
    </div>
  </div>
  <div class="hero-side">
    <p class="eyebrow"><%= it.t("dashboard.next.eyebrow") %></p>
    <% if (it.nextSyncAt) { %>
      <p class="hero-side-figure"><span class="rel-ts" data-ts="<%= it.nextSyncAt %>"><%= f.time(it.nextSyncAt) %></span></p>
      <p class="hero-side-text"><%= f.dateTime(it.nextSyncAt) %></p>
    <% } else { %>
      <p class="hero-side-text"><%= it.t("dashboard.next.none") %></p>
    <% } %>
    <a class="text-button" href="/schedules"><%= it.t("dashboard.next.link") %> <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
  </div>
</section>

<div class="metric-grid">
  <a class="metric" href="/connections">
    <span><%= it.t("dashboard.connections") %></span>
    <% if (it.connectionCount > 0) { %>
      <strong><%= f.num(it.connectionCount) %></strong>
      <% if (it.relinkCount > 0) { %>
        <span class="alert"><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i><%= it.t("dashboard.relinkAlert", { count: it.relinkCount }) %></span>
      <% } else { %>
        <small><%= it.t("dashboard.accounts", { count: f.num(it.accountCount) }) %></small>
      <% } %>
    <% } else { %>
      <small><%= it.t("dashboard.noConnections") %></small>
    <% } %>
  </a>

  <a class="metric" href="/profiles">
    <span><%= it.t("dashboard.profiles") %></span>
    <% if (it.profileCount > 0) { %>
      <strong><%= f.num(it.profileCount) %></strong>
      <small><%= it.t("dashboard.profilesDetail") %></small>
    <% } else { %>
      <small><%= it.t("dashboard.noProfiles") %></small>
    <% } %>
  </a>

  <a class="metric" href="/profiles">
    <span><%= it.t("dashboard.routed") %></span>
    <% if (it.coverage.total > 0) { %>
      <strong><%= it.t("dashboard.routedValue", { routed: f.num(it.coverage.routed), total: f.num(it.coverage.total) }) %></strong>
      <span class="meter" aria-hidden="true"><span style="width: <%= (it.coverage.routed / it.coverage.total * 100).toFixed(1) %>%"></span></span>
      <small><%= it.t("dashboard.routedDetail") %></small>
    <% } else { %>
      <small><%= it.t("dashboard.noAccounts") %></small>
    <% } %>
  </a>

  <a class="metric" href="/history">
    <span><%= it.t("dashboard.success") %></span>
    <% if (it.outcomes.rate !== null) { %>
      <strong><%= f.pct(it.outcomes.rate) %></strong>
      <small><%= it.t("dashboard.successDetail", { runs: f.num(it.outcomes.runs), failed: f.num(it.outcomes.failed) }) %></small>
    <% } else { %>
      <small><%= it.t("dashboard.noRuns") %></small>
    <% } %>
  </a>

  <% if (it.isAdmin) { %>
    <div class="metric">
      <span><%= it.t("dashboard.otherUsers") %></span>
      <% if (it.otherUsers > 0) { %>
        <strong><%= f.num(it.otherUsers) %></strong>
        <small><%= it.t("dashboard.otherUsersDetail") %></small>
      <% } else { %>
        <small><%= it.t("dashboard.noOtherUsers") %></small>
      <% } %>
    </div>
  <% } %>
</div>

<div class="two-col">
  <section class="panel">
    <div class="panel-head"><div class="panel-head-main">
      <h3><%= it.t("dashboard.daily.title") %></h3>
      <p class="muted small"><%= it.t("dashboard.daily.desc") %></p>
    </div></div>
    <%~ include("partials/column_chart", { points: it.daily, fmt: f, t: it.t, caption: it.t("dashboard.daily.title") }) %>
  </section>
  <section class="panel">
    <div class="panel-head"><div class="panel-head-main">
      <h3><%= it.t("dashboard.byConnection.title") %></h3>
      <p class="muted small"><%= it.t("dashboard.byConnection.desc") %></p>
    </div></div>
    <%~ include("partials/bar_list", { rows: it.byConnection, fmt: f, empty: it.t("insights.chart.empty") }) %>
  </section>
</div>

<section class="panel">
  <div class="panel-head"><div class="panel-head-main">
    <h3><%= it.t("dashboard.syncStatus") %></h3>
    <p class="muted small"><%= it.t("dashboard.syncStatusDesc") %></p>
  </div></div>
  <% if (it.connectionSyncs.length === 0) { %>
    <p class="muted small"><%= it.t("dashboard.noConnections") %></p>
  <% } else { %>
    <ul class="row-list">
      <% it.connectionSyncs.forEach(function(c) { %>
        <li class="row">
          <span class="row-icon" aria-hidden="true"><i class="fa-solid fa-building-columns"></i></span>
          <span class="row-main">
            <span class="row-title"><%= c.institutionName ?? it.t("health.unknownBank") %> <%~ include("partials/freshness_chip", { kind: c.freshness, t: it.t }) %></span>
            <span class="row-secondary">
              <% if (c.lastSyncedAt) { %><%= it.t("dashboard.lastSync") %> <span class="rel-ts" data-ts="<%= c.lastSyncedAt %>"><%= f.dateTime(c.lastSyncedAt) %></span><% } else { %><%= it.t("dashboard.neverSynced") %><% } %>
            </span>
          </span>
          <span class="row-aside">
            <% if (c.nextRunAt) { %>
              <span><%= it.t("dashboard.nextSyncCol") %></span>
              <small class="local-ts" data-ts="<%= c.nextRunAt %>"><%= f.dateTime(c.nextRunAt) %></small>
            <% } else { %>
              <small><%= it.t("dashboard.noSchedule") %></small>
            <% } %>
          </span>
        </li>
      <% }) %>
    </ul>
  <% } %>
</section>
